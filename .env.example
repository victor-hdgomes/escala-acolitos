# Supabase — https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Projetos novos entregam uma "publishable key" (sb_publishable_...); os
# antigos, uma "anon key" (JWT). O app aceita qualquer uma das duas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA-PUBLISHABLE-KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-ANON-KEY

# Service role (server-only — NUNCA expor no client).
# É o que permite o acesso por link público, já validado por token.
SUPABASE_SERVICE_ROLE_KEY=SUA-SERVICE-ROLE-KEY

# URL pública do app. Entra nos links que vão para o WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
# Sem a chave, o app funciona normalmente e só não envia e-mail.
RESEND_API_KEY=
RESEND_FROM=Escala <onboarding@resend.dev>

# Protege /api/cron/lembretes. O Vercel Cron manda este valor no Authorization.
CRON_SECRET=

# Sal do hash de IP na auditoria. Troque por um valor aleatório.
AUDIT_IP_SALT=
