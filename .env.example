# Supabase: https://app.supabase.com, Settings, API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New projects hand out a "publishable key" (sb_publishable_...); older ones an
# "anon key" (a JWT). The app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role. Server only, NEVER expose it to the browser.
# It is what lets the public links work, after the token has been checked.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# The app's public URL. It goes into every link posted in the group chat.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend: https://resend.com/api-keys
# Without the key the app works the same and simply sends no email.
RESEND_API_KEY=
RESEND_FROM=Altar Roster <onboarding@resend.dev>

# Protects /api/cron/reminders. Vercel Cron sends this value in Authorization.
CRON_SECRET=

# Salt for the hashed IP in the audit log. Replace with a random value.
AUDIT_IP_SALT=
